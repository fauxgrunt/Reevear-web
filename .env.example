RESEND_API_KEY=
CONTACT_TO_EMAIL=reeveartechadmin@gmail.com
# Leave empty until a domain is verified in Resend. The app then uses Resend's test sender.
# After verifying a domain: REEVEAR <hello@your-domain>
RESEND_FROM_EMAIL=
# Optional. Create an Audience in Resend and paste its ID to store newsletter signups there.
RESEND_AUDIENCE_ID=

# Stripe secret key from the Developers dashboard. Use the test key until you are ready to charge real cards.
STRIPE_SECRET_KEY=
# Publishable key from the same Stripe page. Hosted checkout uses the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for the webhook endpoint /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Public site URL used for the return from Stripe. Example: https://reevear.com
NEXT_PUBLIC_SITE_URL=
